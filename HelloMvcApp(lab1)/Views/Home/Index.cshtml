@{
    ViewData["Title"] = "Laboratory work 1";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Lab #1</h4>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Student:</strong> @ViewBag.StudentName</li>
                <li class="list-group-item"><strong>Group:</strong> @ViewBag.StudentGroup</li>
                <li class="list-group-item"><strong>University:</strong> @ViewBag.University</li>
                <li class="list-group-item"><strong>Course project topic:</strong> @ViewBag.CourseProjectTopic</li>
            </ul>
        </div>
    </div>
</div>
